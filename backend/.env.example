DB_HOST=localhost
DB_PORT=5432
DB_NAME=plataforma_energia
DB_USER=postgres
DB_PASSWORD=postgres_dev

# Autenticação (JWT). Troque o segredo; use 32+ caracteres aleatórios fora do ambiente de estudo.
JWT_SECRET=troque-este-segredo-de-desenvolvimento-123456
JWT_EXPIRES_IN=8h

# Opcional: administrador criado por `npm run usuario:criar` e pelo Docker Compose.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@energia.local
ADMIN_SENHA=trocar-esta-senha-123
